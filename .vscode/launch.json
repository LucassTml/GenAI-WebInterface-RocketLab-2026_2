// Aba "Run and Debug" (Ctrl+Shift+D): escolha a configuração e aperte F5.
// O "env"/"--provedor" de cada configuração sobrescreve o PROVEDOR_LLM do .env.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web (Streamlit) - provedor do .env",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "app.py"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Web (Streamlit) - auto (vários provedores)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "app.py"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PROVEDOR_LLM": "auto"
      }
    },
    {
      "name": "Web (Streamlit) - Antigravity CLI (agy)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "app.py"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PROVEDOR_LLM": "agy"
      }
    },
