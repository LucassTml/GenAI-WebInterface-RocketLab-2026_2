# Copie este arquivo para ".env" e preencha as chaves que for usar.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/Mac:             cp .env.example .env
# Tudo aqui também pode ser configurado pela interface web, na tela "Modelos e chaves".

# =========================== PROVEDOR ======================================
# openrouter | nvidia | google | opencode | anthropic | openai | ollama
# agy | claude-code | codex | opencode-cli | auto
PROVEDOR_LLM=openrouter

# Ordem usada quando PROVEDOR_LLM=auto (só entram os provedores disponíveis)
ORDEM_PROVEDORES_AUTO=openrouter,nvidia,google,opencode,ollama

# =========================== CHAVES DE API ================================
# OpenRouter  -> https://openrouter.ai/keys            (grátis, 50 req/dia)
OPENROUTER_API_KEY=sk-or-v1-COLE_SUA_CHAVE_AQUI
# NVIDIA      -> https://build.nvidia.com  (Get API Key, começa com nvapi-)
NVIDIA_API_KEY=
# Google      -> https://aistudio.google.com/apikey    (plano gratuito do Gemini API)
GOOGLE_API_KEY=
# OpenCode Zen-> https://opencode.ai/auth              (modelos -free sem custo)
OPENCODE_API_KEY=
# Anthropic   -> https://platform.claude.com/settings/keys (pago por uso)
ANTHROPIC_API_KEY=
# OpenAI      -> https://platform.openai.com/api-keys  (pago por uso)
OPENAI_API_KEY=

# =========================== MODELOS (em ordem de fallback) ===============
MODELOS_LLM=nvidia/nemotron-3.5-lightning:free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,openrouter/free
MODELOS_NVIDIA=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-super-120b-a12b,openai/gpt-oss-20b
MODELOS_GOOGLE=gemini-flash-latest,gemini-3.8-flash,gemini-3.5-flash-lite
MODELOS_OPENCODE=nemotron-3.5-lightning-free,deepseek-v4-flash-free,fledge-alpha-free
MODELOS_ANTHROPIC=claude-opus-5-5
MODELOS_OPENAI=gpt-5.6-terra,gpt-5.4-mini
# Ollama (local): inicie com scripts\iniciar_ollama.ps1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODELO=qwen2.5:3b
# CLIs (usam o login de cada ferramenta; "padrao" = modelo configurado na CLI)
MODELOS_AGY=gemini-3.8-flash-medium
MODELOS_CLAUDE_CODE=padrao
MODELOS_CODEX=padrao
MODELOS_OPENCODE_CLI=padrao

# =========================== OUTROS ========================================
MAX_CHAMADAS_LLM=5
CINEDATA_DB=data/cinerocket.db
CACHE_ATIVO=true
CACHE_VALIDADE_HORAS=72
TIMEOUT_SQL_SEGUNDOS=90
