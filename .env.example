# Copie este arquivo para ".env" e preencha a chave.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/Mac:             cp .env.example .env

# ---- LLM ------------------------------------------------------------------
# Chave do OpenRouter: crie em https://openrouter.ai/keys (começa com sk-or-v1-)
OPENROUTER_API_KEY=sk-or-v1-COLE_SUA_CHAVE_AQUI

# Provedor do LLM:
#   openrouter -> modelos gratuitos do OpenRouter (padrão, 50 req/dia)
#   nvidia     -> API da NVIDIA (build.nvidia.com), precisa da NVIDIA_API_KEY
#   ollama     -> modelo local, sem internet e sem cota (scripts/iniciar_ollama.ps1)
#   auto       -> tenta OpenRouter, depois NVIDIA, depois Ollama (só os disponíveis)
PROVEDOR_LLM=openrouter

# Modelos gratuitos em ordem de preferência. Se o primeiro estiver lotado (429),
# o agente tenta o próximo. Lista atualizada: python scripts/listar_modelos_free.py
MODELOS_LLM=nvidia/nemotron-3.5-lightning:free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,openrouter/free

# Máximo de chamadas ao LLM por pergunta (protege a cota de 50 req/dia)
MAX_CHAMADAS_LLM=5

# NVIDIA: gere a chave em https://build.nvidia.com (botão "Get API Key", começa com nvapi-)
NVIDIA_API_KEY=
MODELOS_NVIDIA=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-super-120b-a12b,openai/gpt-oss-20b

# Ollama (modelo local). Pode listar mais de um separado por vírgula.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODELO=qwen2.5:3b

# Ordem do modo auto
ORDEM_PROVEDORES_AUTO=openrouter,nvidia,ollama

# ---- Banco / cache --------------------------------------------------------
CINEDATA_DB=data/cinerocket.db
CACHE_ATIVO=true
CACHE_VALIDADE_HORAS=72
TIMEOUT_SQL_SEGUNDOS=90
